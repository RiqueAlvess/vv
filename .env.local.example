NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
RESEND_API_KEY=re_xxxx
DEFAULT_FROM_EMAIL=help@yourdomain.com
ENCRYPTION_KEY=replace_with_64_hex_chars_openssl_rand_hex_32
NEXT_PUBLIC_APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
# Required in all environments — the cron endpoint returns 500 if this is unset
CRON_SECRET=your-secret-here

# Branding (public URLs used in UI)
NEXT_PUBLIC_AUTH_BG_IMAGE_URL=/bg.jpeg
NEXT_PUBLIC_LOGO_URL=/logo.png

# ── HSE Agent (Plano de Ação com IA) ──────────────────────────────────────
# Escolha um provider: openrouter | openai | anthropic
LLM_PROVIDER=openrouter

# OpenRouter (padrão — acessa Llama, Mistral, etc.)
OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAI (ativar quando LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (ativar quando LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
